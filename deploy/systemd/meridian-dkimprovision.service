[Unit]
Description=Provision Meridian DKIM signing keys for mail domains
Documentation=https://github.com/meridian-mail/meridian
After=postgresql.service redis-server.service rspamd.service
Wants=postgresql.service redis-server.service rspamd.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/meridian
EnvironmentFile=/opt/meridian/secrets/app.env
ExecStart=/opt/meridian/bin/meridian-dkimprovision
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/rspamd/dkim
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
AmbientCapabilities=
