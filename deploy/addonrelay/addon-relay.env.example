# Optional managed Alt8Mail add-on OAuth relay.
# Deploy this only on the central connect.<alt8mail-domain> host. Do not put
# provider client secrets in a tenant webmail environment.
ADDON_RELAY_LISTEN=127.0.0.1:8099
ADDON_RELAY_PUBLIC_URL=https://connect.alt8mail.com
ADDON_RELAY_SECRET=replace-with-a-long-random-shared-secret
ADDON_RELAY_SLACK_CLIENT_ID=
ADDON_RELAY_SLACK_CLIENT_SECRET=
